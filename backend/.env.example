# Copy this file to backend/.env and replace CHANGE_ME with your own password.
# backend/.env is git-ignored. Never commit real credentials.
# Environment variables with the same names override values in backend/.env.
#
# URL format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains special characters such as @ : / ? # % or a space,
# URL-encode them (for example @ becomes %40).

# Development database (required)
DATABASE_URL=postgresql+psycopg://gedp_app:CHANGE_ME@localhost:5432/gedp_dev

# Test database (used by integration tests; its name must end in _test and differ from DATABASE_URL)
TEST_DATABASE_URL=postgresql+psycopg://gedp_app:CHANGE_ME@localhost:5432/gedp_test

# Trust X-Forwarded-For only from the local Vite dev proxy, so the dashboard's Run button works
# through it while clients on other machines are still refused (D-39). Remove to trust no proxy.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Optional settings. The values shown are the defaults; uncomment to change them.
# API_BASE_URL=https://api.worldbank.org/v2
# COUNTRY_CODES=IND,USA,GBR,DEU,JPN,CHN,BRA,ZAF,CAN,AUS
# INDICATOR_CODES=NY.GDP.MKTP.CD,SP.POP.TOTL,SL.UEM.TOTL.ZS
# INDICATOR_UNITS='{"NY.GDP.MKTP.CD": "current US$", "SP.POP.TOTL": "people", "SL.UEM.TOTL.ZS": "% of total labor force"}'
# START_YEAR=2005
# END_YEAR=2024
# PER_PAGE=1000
# REQUEST_TIMEOUT_SECONDS=30
# MAX_RETRIES=3
# RETRY_BACKOFF_SECONDS=1
# STALE_RUN_MINUTES=60
# DEFAULT_INDICATOR_CODE=NY.GDP.MKTP.CD
# DEFAULT_COUNTRY_CODES=IND,USA,CHN,DEU,BRA
# ENABLE_MANUAL_TRIGGER=true
# WRITE_JSON_REPORT=false
# REPORTS_DIR=reports
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:5173
